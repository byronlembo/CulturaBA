{
  "name": "@culturaba/ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "Worker de ingestión: conectores por institución, normalización, dedup, detección de cambios",
  "type": "module",
  "bin": {
    "culturaba-ingest": "./bin/ingest.js"
  },
  "scripts": {
    "ingest": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@culturaba/shared": "workspace:*",
    "cheerio": "1.2.0",
    "commander": "15.0.0",
    "luxon": "3.7.2",
    "p-queue": "10.0.0",
    "p-retry": "8.0.1",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "22.19.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "5.0.4"
  }
}
