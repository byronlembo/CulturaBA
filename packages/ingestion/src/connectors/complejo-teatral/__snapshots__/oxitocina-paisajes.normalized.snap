  {
    "source": "complejo-teatral",
    "externalId": "paisajes-coreograficos",
    "url": "https://complejoteatral.gob.ar/produccion/paisajes-coreograficos/",
    "capturedAt": "2026-10-14T12:00:00.000-03:00",
    "title": "PAISAJES COREOGRÁFICOS",
    "subtitle": "Muestra de piezas breves",
    "description": "Taller de Danza Contemporánea\ndel Teatro San Martín\n\nsinopsis\nEn Paisajes coreográficos, estudiantes y bailarines comparten con el público parte del proceso creativo y de aprendizaje desarrollado durante las clases, a través de piezas de corta duración que ponen en escena distintas formas de explorar, experimentar y componer. Una oportunidad para acercarse a la labor cotidiana de los alumnos y conocer, a partir del movimiento, cómo se desarrolla en el Taller la formación en danza contemporánea desde diferentes abordajes y materias.",
    "attribution": "Texto: Complejo Teatral de Buenos Aires",
    "disciplines": [
      "danza"
    ],
    "institutionSlug": "complejo-teatral",
    "officialUrl": "https://complejoteatral.gob.ar/produccion/paisajes-coreograficos/",
