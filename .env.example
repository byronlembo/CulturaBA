# ─────────────────────────────────────────────────────────────────────────────
# CulturaBA — variables de entorno (copiar a .env; .env está en .gitignore)
# Ningún valor de este archivo es secreto. Los secretos reales van SOLO en .env
# local o en los secretos del repositorio en GitHub Actions.
# ─────────────────────────────────────────────────────────────────────────────

# ── Worker de ingestión (packages/ingestion) ────────────────────────────────
# Conexión Postgres con permisos de escritura. Nunca se usa desde la app móvil.
#  · Local:    pnpm db:url  →  postgresql://postgres@localhost:54329/culturaba
#  · Supabase: usar el SESSION POOLER (IPv4) de Settings → Database, no el host db.<ref>.supabase.co
DATABASE_URL=postgresql://postgres@localhost:54329/culturaba

# Base usada por los tests de integración (se recrea en cada corrida).
TEST_DATABASE_URL=postgresql://postgres@localhost:54329/culturaba_test

# Identificación cortés ante los sitios de las instituciones (incluir contacto).
INGEST_USER_AGENT="CulturaBA-Ingest/0.1 (+https://culturaba.lembodiseno.com/bot)"

# Resúmenes "Qué esperar" generados por IA. Apagado en Etapa 1.
AI_SUMMARY_ENABLED=false

# Nivel de log de pino: trace|debug|info|warn|error
LOG_LEVEL=info

# ── Supabase (proyecto en la nube) ──────────────────────────────────────────
# URL y clave PUBLICABLE (segura en el cliente). La clave SECRETA (sb_secret_…)
# solo la necesitan scripts de administración; nunca la app.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=

# ── App móvil (apps/mobile) — solo variables EXPO_PUBLIC_* llegan al bundle ──
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Base de los enlaces compartidos / universal links (sin barra final).
EXPO_PUBLIC_WEB_BASE_URL=https://culturaba.lembodiseno.com
