# Variables de la app (solo EXPO_PUBLIC_* llegan al bundle). Copiar a apps/mobile/.env.

# ── Opción A: Supabase (producción / staging) ───────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Opción B: Postgres local vía `pnpm dev:api` (sin Supabase) ──────────────
# EXPO_PUBLIC_API_MODE=dev
# EXPO_PUBLIC_DEV_API_URL=http://localhost:8787

# Base de los enlaces compartidos / universal links (sin barra final).
EXPO_PUBLIC_WEB_BASE_URL=https://culturaba.xn--lembodiseo-19a.com
